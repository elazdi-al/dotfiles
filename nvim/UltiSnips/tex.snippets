\\`!p snip.rv = match.group(1)`
endsnippet

priority 200
context "math()"
snippet '(?<!\\)(arcsin|arccos|arctan|arccot|pi|int)' "Long functions" rwA
\\`!p snip.rv = match.group(1)`
endsnippet
priority 0

