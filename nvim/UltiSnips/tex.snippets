# ─── Python Helpers ───────────────────────────────────────────────
global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment():
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')")
	return x != '0' and y != '0'
endglobal


# ─── Templates ────────────────────────────────────────────────────

snippet subfile "Subfile document" b
\documentclass[${1:../../main.tex}]{subfiles}
\begin{document}
\chapter{${2:Title}}
\vfill
$0
\end{document}
endsnippet

snippet template "Full document" b
\documentclass[a4paper, 11pt]{${1:article}}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[${2:english}]{babel}
\usepackage{amsmath, amssymb, amsthm}
\usepackage{mathtools, hyperref, geometry, graphicx, enumitem}
\geometry{margin=2.5cm}

\title{${3:Title}}
\author{${4:Author}}
\date{\today}

\begin{document}
\maketitle
$0
\end{document}
endsnippet


