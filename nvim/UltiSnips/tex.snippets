# ─── Layout (tables, minipages, schema inputs) ───────────────────

snippet schema "Centered schema input (subfix)" b
\smallskip
{\centering\input{\subfix{${1:schemas/$2}}}\par}
\smallskip
$0
endsnippet

snippet cinp "Centered input" b
\begin{center}
\input{${1:schemas/$2}}
\end{center}
$0
endsnippet

snippet sinp "Subfix input" b
\input{\subfix{${1:schemas/$2}}}$0
endsnippet

snippet side "Side-by-side minipages" b
\begin{minipage}[t]{${1:0.49}\textwidth}
$2
\end{minipage}
\hfill
\begin{minipage}[t]{${3:0.49}\textwidth}
$0
\end{minipage}
endsnippet

snippet tabx "tabularx" b
\begin{tabularx}{\textwidth}{@{}${1:lX}@{}}
$0
\end{tabularx}
endsnippet

snippet tabxc "Centered tabularx with rules" b
\begin{center}
\begin{tabularx}{\linewidth}{${1:L{3cm} L{5cm} L{5cm}}}
\toprule
\textbf{${2:Col1}} & \textbf{${3:Col2}} & \textbf{${4:Col3}} \\\\
\midrule
$0
\bottomrule
\end{tabularx}
\end{center}
endsnippet

snippet tab "Compact tabular" b
\begin{tabular}{@{}${1:lll}@{}}
$0
\end{tabular}
endsnippet

snippet fig "Figure" b
\begin{figure}[${1:htpb}]
	\centering
	\includegraphics[width=0.8\textwidth]{$2}
	\caption{${3:$2}}
	\label{fig:${4:${2/\W+/-/g}}}
\end{figure}
endsnippet

snippet table "Table float" b
\begin{table}[${1:htpb}]
	\centering
	\caption{${2:caption}}
	\label{tab:${3:label}}
	\begin{tabular}{${4:c}}
	$0
	\end{tabular}
\end{table}
endsnippet


